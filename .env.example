# Public site origin for canonical/OG/sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Empty = browser uses same-origin /api (recommended). Next rewrites to API_BACKEND_URL.
# Set to the API origin only for direct browser→API calls (CORS required).
NEXT_PUBLIC_API_BASE_URL=

# Server-only auth-service origin used by Next.js /api rewrites.
API_BACKEND_URL=http://localhost:8081
